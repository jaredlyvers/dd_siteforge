<div class="dd-alert {{parent_type}} {{parent_class}}" role="alert" data-sal="{{sal}}">
  <div class="dd-alert__content dd-g">
    <div class="dd-u-1-1">
      <div class="l-box">
        {{#if has_title}}<div class="dd-alert__title">{{parent_title}}</div>{{/if}}
        <div class="dd-alert__copy">
          <p>{{parent_copy}}</p>
        </div>
      </div>
    </div>
  </div>
</div>
